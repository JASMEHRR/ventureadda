# Copy to .env and fill in from Firebase console → Project settings → Your apps.
#
# These are not secrets — Firebase web config ships in the client bundle and is
# publicly readable by design. Security comes from firestore.rules, not from
# hiding these values. They live here so the project can be swapped and so the
# same names can be set in Vercel.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary, standing in for Firebase Storage, which requires the paid plan.
# Both are public by design — the preset is unsigned so the browser can upload
# without a signature. Never put the API secret here or anywhere in src/.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY. Set these in Vercel → Settings → Environment Variables.
# They must NOT have a VITE_ prefix: anything prefixed VITE_ is compiled into
# the client bundle in plain text, where the Groq key would be readable by
# anyone who opens devtools, along with the quota attached to it.
#
# These belong in Vercel, not in this file's local copy — `vite` never reads
# them, and only `vercel dev` will serve /api locally.
# ---------------------------------------------------------------------------

# console.groq.com → API Keys. Used by api/extract-menu.ts.
GROQ_API_KEY=

# Same value as VITE_FIREBASE_PROJECT_ID. The function checks incoming ID
# tokens against it, so a valid token from another Firebase project is refused.
FIREBASE_PROJECT_ID=

# Optional. Default to thapar.edu and the owner address baked into the function.
ALLOWED_EMAIL_DOMAIN=
OWNER_EMAIL=
