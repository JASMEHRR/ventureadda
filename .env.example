# Copy to .env and fill in from Firebase console → Project settings → Your apps.
#
# These are not secrets — Firebase web config ships in the client bundle and is
# publicly readable by design. Security comes from firestore.rules, not from
# hiding these values. They live here so the project can be swapped and so the
# same names can be set in Vercel.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web push, for telling a seller an order has arrived while the site is closed.
# Firebase console → Project settings → Cloud Messaging → Web Push certificates
# → Generate key pair, then paste the PUBLIC key here.
#
# Public by design, like everything else above: a VAPID public key identifies
# the sender to the browser, it authorises nothing. The matching private half
# stays inside Firebase and is never downloaded.
#
# LEAVE IT EMPTY AND PUSH TURNS ITSELF OFF — lib/push.ts reports itself
# unconfigured, no permission is ever requested, and the toggle on the orders
# page does not render. Everything else works unchanged.
VITE_FIREBASE_VAPID_KEY=

# Cloudinary, standing in for Firebase Storage, which requires the paid plan.
# Both are public by design — the preset is unsigned so the browser can upload
# without a signature. Never put the API secret here or anywhere in src/.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY. Set these in Vercel → Settings → Environment Variables.
# They must NOT have a VITE_ prefix: anything prefixed VITE_ is compiled into
# the client bundle in plain text, where the Groq key would be readable by
# anyone who opens devtools, along with the quota attached to it.
#
# These belong in Vercel, not in this file's local copy — `vite` never reads
# them, and only `vercel dev` will serve /api locally.
# ---------------------------------------------------------------------------

# console.groq.com → API Keys. Used by api/extract-menu.ts.
GROQ_API_KEY=

# Same value as VITE_FIREBASE_PROJECT_ID. The function checks incoming ID
# tokens against it, so a valid token from another Firebase project is refused.
FIREBASE_PROJECT_ID=

# Optional. Default to thapar.edu and the owner address baked into the function.
ALLOWED_EMAIL_DOMAIN=
OWNER_EMAIL=

# The service account key JSON, on ONE line, used by api/notify-order.ts to read
# an order and send the push through FCM.
#
# Firebase console → Project settings → Service accounts → Generate new private
# key. Open the downloaded .json, copy the WHOLE file, paste it as the value.
# Vercel will store the newlines inside private_key as literal \n, which
# _google-auth.ts converts back — that is expected, do not try to fix it by hand.
#
# THIS ONE IS A REAL SECRET, unlike everything above it. It grants full admin
# access to the entire Firebase project, bypassing firestore.rules completely.
# Never give it a VITE_ prefix, never commit it, never paste it into a chat. If
# it leaks, revoke that key in the console immediately and generate a new one.
#
# LEAVE IT EMPTY AND PUSH SENDING TURNS ITSELF OFF — the endpoint returns 204
# and does nothing. Orders are unaffected; sellers just find out by opening the
# site, same as before.
FIREBASE_SERVICE_ACCOUNT=
