# Copy to .env and fill in from Firebase console → Project settings → Your apps.
#
# These are not secrets — Firebase web config ships in the client bundle and is
# publicly readable by design. Security comes from firestore.rules, not from
# hiding these values. They live here so the project can be swapped and so the
# same names can be set in Vercel.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
