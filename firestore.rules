rules_version = '2';

// VentureAdda Firestore security rules.
//
// PASTE THIS INTO Firebase console → Firestore Database → Rules → Publish.
//
// Why this cannot wait for Step 4:
//
// 1. Test mode allows every read and write from anyone on the internet who
//    knows the project id — and the project id ships in the client bundle.
//    From Step 2 onward the users collection holds real student email
//    addresses, so test mode means those addresses are world-readable and
//    anyone can overwrite them.
// 2. The @thapar.edu check in the app runs in the browser. Anyone can call the
//    Firebase Auth REST API directly with any address and get a valid account.
//    These rules are the only place that restriction is actually enforced.
// 3. Enabling email-link sign-in also enabled the parent Email/Password
//    provider, so accounts can be created with a password outside our UI. The
//    domain check below covers those too, because it tests the token rather
//    than trusting how the account was made.
//
// Spark plan means no Cloud Functions, so there is no server-side hook to put
// this logic in. Rules are it.

service cloud.firestore {
  match /databases/{database}/documents {

    // The site owner. Identified by address rather than by a flag on a
    // document, so it cannot be revoked by anything that goes wrong in the
    // users collection and does not depend on a manual console step.
    //
    // email_verified is what makes this safe. Enabling email-link sign-in also
    // enabled the Email/Password provider, so an account with this address
    // could in principle be created outside our UI — but not verified without
    // access to the inbox, and an unverified token fails here.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'jasmehr2005@gmail.com';
    }

    // Anyone signed in with a verified address, Thapar or not. Google Sign-In
    // means outsiders can hold an account: they can pick a username, browse,
    // and leave reviews. They cannot post in chat or list a venture — those
    // stay behind isThaparUser below.
    //
    // email_verified matters even with Google, because the Email/Password
    // provider is also enabled and an unverified account can exist.
    function isVerifiedUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    // The privileged boundary: posting in All Chat and listing a venture.
    // Full-string match, so an address like someone@thapar.edu.example.com does
    // not slip through. The owner is exempt — the address above is not a Thapar
    // one and would otherwise be unable to moderate at all.
    //
    // The third clause is the pre-approval list: an outside address the owner
    // has explicitly added to approvedEmails gets the same standing as a
    // Thapar one, checked by existence alone — see that collection below.
    function isThaparUser() {
      return isOwner()
        || (request.auth != null
            && request.auth.token.email != null
            && request.auth.token.email_verified == true
            && request.auth.token.email.lower().matches('.*@thapar[.]edu'))
        || (request.auth != null
            && request.auth.token.email != null
            && request.auth.token.email_verified == true
            && exists(/databases/$(database)/documents/approvedEmails/$(request.auth.token.email.lower())));
    }

    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      // Usernames are shown next to chat messages and ventures, so any signed-in
      // user needs to resolve them. This does expose email addresses to signed-in
      // students; tighten it when chat lands if that turns out to matter.
      allow read: if request.auth != null;

      allow create: if isVerifiedUser()
                    && isSelf(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.email == request.auth.token.email
                    // Nobody gets to make themselves a moderator. Flip this by
                    // hand in the console.
                    && request.resource.data.isModerator == false
                    && request.resource.data.username is string
                    && request.resource.data.username.size() >= 3
                    && request.resource.data.username.size() <= 20;

      allow update: if (isVerifiedUser()
                        && isSelf(uid)
                        && request.resource.data.isModerator == resource.data.isModerator
                        && request.resource.data.email == resource.data.email
                        && request.resource.data.uid == resource.data.uid)
                    // The owner promoting or revoking someone else, and nothing
                    // else about their document — a moderator-picker UI writes
                    // through this, not through the self-update branch above,
                    // which forbids touching isModerator at all.
                    || (isOwner()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isModerator'])
                        && request.resource.data.isModerator is bool)
                    // Self-promotion on first sign-in, and only in that exact
                    // direction: false to true, gated on a matching
                    // approvedEmails entry with moderator == true. This is how
                    // a pre-approval actually takes effect without the owner
                    // having to come back and flip it by hand afterwards.
                    || (isVerifiedUser()
                        && isSelf(uid)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isModerator'])
                        && resource.data.isModerator == false
                        && request.resource.data.isModerator == true
                        && request.auth.token.email != null
                        // exists() first: get() on a document that is not
                        // there errors the whole rule instead of just failing
                        // it, and the overwhelming majority of accounts have
                        // no approvedEmails entry at all.
                        && exists(/databases/$(database)/documents/approvedEmails/$(request.auth.token.email.lower()))
                        && get(/databases/$(database)/documents/approvedEmails/$(request.auth.token.email.lower())).data.moderator == true);

      // Deleting a user would orphan their username claim and their ventures.
      allow delete: if false;

      /**
       * FCM registration tokens for this account's own devices, one per
       * document, id = SHA-256 of the token so re-enabling on the same device
       * overwrites rather than duplicating.
       *
       * A SUBCOLLECTION RATHER THAN A FIELD ON THE USER DOCUMENT, and that is
       * the whole point. users/{uid} is readable by anyone signed in, because
       * usernames have to be resolvable next to chat messages and ventures. A
       * registration token sitting in that document would be readable by every
       * account on the site — and an attacker who copied someone else's token
       * into their own list could aim this site's order notifications at a
       * stranger's phone. Here, only the owner can read or write them.
       *
       * api/notify-order.ts reads these with service-account credentials, which
       * bypass rules entirely, so tightening this costs the server nothing.
       */
      match /pushTokens/{tokenId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isVerifiedUser()
                              && isSelf(uid)
                              && request.resource.data.keys().hasOnly(['token', 'createdAt'])
                              && request.resource.data.token is string
                              && request.resource.data.token.size() > 0
                              && request.resource.data.token.size() <= 500
                              && request.resource.data.createdAt == request.time;
      }
    }

    match /approvedEmails/{emailId} {
      // A signed-in user may read their own entry, so the client can tell
      // whether to grant posting rights and whether to self-promote to
      // moderator on first sign-in (see users/{uid} update and isThaparUser
      // above). A moderator may read the whole collection, to manage it.
      allow read: if isModerator()
                  || (request.auth != null
                      && request.auth.token.email != null
                      && request.auth.token.email.lower() == emailId);

      // Only the actual owner decides who gets standing before they have
      // even signed up — this is a step above ordinary moderation.
      allow write: if isOwner() && request.resource.data.moderator is bool;
    }

    // Username uniqueness. The document id IS the claim: ids are unique by
    // definition, and create-only-if-absent is what Firestore's create rule
    // already means, so two people picking the same name at the same moment
    // cannot both succeed.
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if isVerifiedUser() && request.resource.data.uid == request.auth.uid;
      // Immutable — releasing a name would let someone impersonate a past owner.
      allow update, delete: if false;
    }

    // The owner is always a moderator, checked first so it costs no document
    // read and works before any user document exists. Other moderators are
    // still promoted by hand in the console.
    function isModerator() {
      return isOwner()
        || (request.auth != null
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isModerator == true);
    }

    match /ventures/{ventureId} {
      // Three ways to read, and each corresponds to a query the app actually
      // makes. Firestore checks a list query against these, so browse must
      // filter status == 'live', the moderator queue must filter by status,
      // and an owner's own list must filter by ownerId. A query that filters
      // by none of them is refused, which is the intent: nobody can page
      // through everyone's pending submissions.
      allow read: if resource.data.status == 'live'
                  || isModerator()
                  || (request.auth != null && resource.data.ownerId == request.auth.uid);

      allow create: if isThaparUser()
                    && request.resource.data.ownerId == request.auth.uid
                    // The entire point of the approval queue. An owner who
                    // could set this would publish straight past you.
                    && request.resource.data.status == 'pending'
                    && request.resource.data.clickCount == 0
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.phone is string
                    && request.resource.data.description.size() <= 600
                    // Optional, and capped: these are published to buyers and
                    // an unbounded list is an unbounded document.
                    && (!('deliverySlots' in request.resource.data)
                        || (request.resource.data.deliverySlots is list
                            && request.resource.data.deliverySlots.size() <= 12));

      // Owners may edit content but never status, ownership or the counters.
      // Moderators may change anything, which is how approve and reject work.
      // The first clause is the public view counter, same shape as the one on
      // menu items: exactly one field, exactly plus one.
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount'])
                        && request.resource.data.clickCount == resource.data.clickCount + 1)
                    || isModerator()
                    || (isThaparUser()
                        && resource.data.ownerId == request.auth.uid
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.status == resource.data.status
                        && request.resource.data.clickCount == resource.data.clickCount
                        // Capped on edit as well as on create. Every slot is
                        // rendered in the checkout dialog, so an unbounded list
                        // here is an unbounded list in front of every buyer.
                        && (!('deliverySlots' in request.resource.data)
                            || (request.resource.data.deliverySlots is list
                                && request.resource.data.deliverySlots.size() <= 12)));

      allow delete: if isModerator()
                    || (request.auth != null && resource.data.ownerId == request.auth.uid);
    }

    match /menuItems/{itemId} {
      // Menu items carry no private data and are always read alongside their
      // venture, so gating them on a get() of the parent would cost an extra
      // billed read per item to protect a price list.
      allow read: if true;

      allow create: if isThaparUser()
                    && request.resource.data.inquiryCount == 0
                    && request.resource.data.price is number
                    && request.resource.data.price >= 0
                    && request.resource.data.inStock is bool
                    // Optional. Absent means the seller is not counting units,
                    // which is the common case and must stay writable.
                    && (!('stock' in request.resource.data)
                        || request.resource.data.stock == null
                        || (request.resource.data.stock is int
                            && request.resource.data.stock >= 0))
                    && get(/databases/$(database)/documents/ventures/$(request.resource.data.ventureId)).data.ownerId == request.auth.uid;

      allow update: if
                    // Anyone at all, signed in or not, may add exactly one to
                    // the inquiry counter and change nothing else. Logged-out
                    // people can browse and tap WhatsApp, and they are most of
                    // the traffic — counting only signed-in taps would throw
                    // away the majority of the evidence. The trade is that the
                    // number is inflatable by anyone willing to script it, so
                    // treat it as a signal of interest, not an audited figure.
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inquiryCount'])
                     && request.resource.data.inquiryCount == resource.data.inquiryCount + 1)
                    || isModerator()
                    || (isThaparUser()
                        && get(/databases/$(database)/documents/ventures/$(resource.data.ventureId)).data.ownerId == request.auth.uid
                        && request.resource.data.inquiryCount == resource.data.inquiryCount);

      allow delete: if isModerator()
                    || (request.auth != null
                        && get(/databases/$(database)/documents/ventures/$(resource.data.ventureId)).data.ownerId == request.auth.uid);
    }

    match /orders/{orderId} {
      // The seller, the buyer, and moderators for support.
      //
      // The buyer clause is new, and it is what makes "track your own orders"
      // possible. The objection to it before was that no per-buyer query
      // existed, so it widened a document holding a name, a phone number and a
      // hostel room for nothing. There is one now — listOrdersForBuyer — and
      // every field it exposes to the buyer is a field the buyer typed.
      //
      // Both clauses are plain equality on a denormalised field, so neither
      // costs a get() of the parent venture. A read rule that costs a billed
      // document read per row is a read rule that gets removed later under
      // pressure.
      allow read: if isModerator()
                  || (request.auth != null && resource.data.ownerId == request.auth.uid)
                  || (request.auth != null && resource.data.buyerUid == request.auth.uid);

      // Any verified account, Thapar or not — outsiders may buy, they just may
      // not sell. Signed-out ordering is deliberately NOT allowed, unlike the
      // inquiry counter and the WhatsApp handoff: an order obliges a real
      // person to make something and hands them a phone number, so it has to
      // be attributable to an account somebody can report.
      allow create: if isVerifiedUser()
                    && request.resource.data.keys().hasOnly([
                         'ventureId', 'ventureName', 'ownerId', 'buyerUid',
                         'buyerName', 'buyerPhone', 'lines', 'total',
                         'contactPreference', 'payment', 'deliveryAddress',
                         'deliverySlot', 'status', 'seen', 'createdAt'
                       ])
                    // Pins the order to the caller. Without this, one account
                    // could paper a seller's dashboard with orders in other
                    // people's names.
                    && request.resource.data.buyerUid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.seen == false
                    // Forces serverTimestamp(). A client-supplied time could
                    // backdate an order to the top of the seller's list.
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.buyerName is string
                    && request.resource.data.buyerName.size() > 0
                    && request.resource.data.buyerName.size() <= 60
                    // Digits only, matching what the client strips it down to.
                    // The seller's dashboard turns this straight into a tel:
                    // link and a wa.me URL, and neither should ever be handed
                    // something that is not a number.
                    && request.resource.data.buyerPhone is string
                    && request.resource.data.buyerPhone.matches('^[0-9]{8,15}$')
                    && request.resource.data.ventureId is string
                    && request.resource.data.ventureId.size() > 0
                    && request.resource.data.deliveryAddress is string
                    && request.resource.data.deliveryAddress.size() > 0
                    && request.resource.data.deliveryAddress.size() <= 200
                    && request.resource.data.deliverySlot is string
                    && request.resource.data.deliverySlot.size() <= 60
                    && request.resource.data.contactPreference in ['buyerContacts', 'sellerContacts']
                    && request.resource.data.payment in ['cod', 'online']
                    // LIMIT OF THIS RULE: `lines` is checked for being a list
                    // of a sane length, and `total` for being a sane number,
                    // but rules cannot iterate a list — so the per-line shape
                    // and the arithmetic linking them are NOT enforced here.
                    // A determined signed-in buyer can write an order whose
                    // total disagrees with its lines. The seller sees both on
                    // the dashboard and settles payment in person, so this is
                    // a visible inconsistency rather than a way to get goods
                    // cheaply. Do not build anything that trusts `total`
                    // without re-summing the lines.
                    && request.resource.data.lines is list
                    && request.resource.data.lines.size() > 0
                    && request.resource.data.lines.size() <= 50
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0
                    && request.resource.data.total <= 1000000
                    && request.resource.data.ventureName is string
                    && request.resource.data.ventureName.size() <= 60
                    // The claimed seller must really own that venture, and it
                    // must be live. Ordering from a pending or rejected
                    // listing is ordering from a business nobody approved.
                    && get(/databases/$(database)/documents/ventures/$(request.resource.data.ventureId)).data.ownerId == request.resource.data.ownerId
                    && get(/databases/$(database)/documents/ventures/$(request.resource.data.ventureId)).data.status == 'live';

      // The seller moving their own order along, and marking it read. Nothing
      // else about the document may change — not the total, not the lines, not
      // the buyer. The record of what was ordered is the point of having one.
      allow update: if request.auth != null
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'seen'])
                    && request.resource.data.status in ['pending', 'paid', 'completed']
                    && request.resource.data.seen is bool;

      // The seller clearing a prank or a duplicate. Buyers cannot withdraw an
      // order — by then the seller may already have made it — they message and
      // sort it out, which is what this whole site is.
      allow delete: if isModerator()
                    || (request.auth != null && resource.data.ownerId == request.auth.uid);
    }

    match /chatMessages/{messageId} {
      // Everyone reads, signed in or not. Someone opening a shared link should
      // be able to see the room is alive before being asked for an account.
      allow read: if true;

      allow create: if isThaparUser()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.username is string
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 1000
                    && request.resource.data.deleted == false
                    // Forces serverTimestamp(). A client-supplied time could be
                    // backdated to bury a message at the top of the room.
                    && request.resource.data.createdAt == request.time;

      // Moderator removal, and the only permitted update. The flag and the
      // blanked text have to move together: a soft delete that leaves the text
      // in the document means the message is still readable by anyone querying
      // Firestore directly, which defeats the whole point of the button. Author
      // and timestamp survive, so a repeat offender is still visible.
      allow update: if isModerator()
                    && request.resource.data.deleted == true
                    && request.resource.data.text == ''
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.username == resource.data.username
                    && request.resource.data.createdAt == resource.data.createdAt;

      // No hard delete. Who posted and when is the moderation trail, and it is
      // worth more than the row it occupies.
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;

      // The document id is ventureId_uid, which is what makes one review per
      // person per venture a structural fact rather than something the app
      // remembers to check. A second review lands on the same id and is an
      // edit, not a duplicate.
      allow create: if isVerifiedUser()
                    && reviewId == request.resource.data.ventureId + '_' + request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() <= 500
                    && request.resource.data.deleted == false
                    && request.resource.data.createdAt == request.time
                    // Nobody reviews their own venture.
                    && get(/databases/$(database)/documents/ventures/$(request.resource.data.ventureId)).data.ownerId != request.auth.uid;

      allow update: if
                    // Moderator removal. Same reasoning as chat: a flag that
                    // leaves the comment in the document is a button that lies.
                    // The rating goes with it — the app drops deleted reviews
                    // from the average, because erasing the words of a malicious
                    // one-star while leaving the score would remove the
                    // sentence and keep the damage.
                    (isModerator()
                     && request.resource.data.deleted == true
                     && request.resource.data.comment == ''
                     && request.resource.data.userId == resource.data.userId
                     && request.resource.data.ventureId == resource.data.ventureId
                     && request.resource.data.createdAt == resource.data.createdAt)
                    // The author revising, while it still stands. Changing your
                    // mind about a venture is legitimate; resurrecting a removed
                    // review is not, hence the check on the existing flag.
                    || (isVerifiedUser()
                        && resource.data.userId == request.auth.uid
                        && resource.data.deleted == false
                        && request.resource.data.deleted == false
                        && request.resource.data.userId == resource.data.userId
                        && request.resource.data.ventureId == resource.data.ventureId
                        && request.resource.data.createdAt == resource.data.createdAt
                        && request.resource.data.rating is int
                        && request.resource.data.rating >= 1
                        && request.resource.data.rating <= 5
                        && request.resource.data.comment is string
                        && request.resource.data.comment.size() <= 500);

      // No hard delete, same as chat: who reviewed what is the trail.
      allow delete: if false;
    }

    match /settings/{settingId} {
      // One global backdrop image, shown to every visitor including
      // signed-out ones, so the read has to be open. Only a moderator can
      // change it; an empty write resets to the default baked into the app.
      allow read: if true;

      allow write: if isModerator()
                   && (!('backdrop' in request.resource.data)
                       || (request.resource.data.backdrop.url is string
                           && request.resource.data.backdrop.publicId is string));
    }

    // TOTAL ACCESS FOR MODERATORS AND THE OWNER, everywhere, asked for
    // explicitly. Rule statements are OR'd, so this widens the collections
    // above rather than replacing them: a moderator now also bypasses the
    // narrow-update rules on orders, reviews and chat, and can hard-delete
    // documents those blocks deliberately refused (the chat/review moderation
    // trail, a user document and its username claim). Every other account is
    // still held to the rules above.
    match /{document=**} {
      allow read, write: if isModerator();
    }

    // Everything else stays closed. Any new collection needs its own rules
    // written alongside the feature, not retrofitted afterwards.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
