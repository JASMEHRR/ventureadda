rules_version = '2';

// VentureAdda Firestore security rules.
//
// PASTE THIS INTO Firebase console → Firestore Database → Rules → Publish.
//
// Why this cannot wait for Step 4:
//
// 1. Test mode allows every read and write from anyone on the internet who
//    knows the project id — and the project id ships in the client bundle.
//    From Step 2 onward the users collection holds real student email
//    addresses, so test mode means those addresses are world-readable and
//    anyone can overwrite them.
// 2. The @thapar.edu check in the app runs in the browser. Anyone can call the
//    Firebase Auth REST API directly with any address and get a valid account.
//    These rules are the only place that restriction is actually enforced.
// 3. Enabling email-link sign-in also enabled the parent Email/Password
//    provider, so accounts can be created with a password outside our UI. The
//    domain check below covers those too, because it tests the token rather
//    than trusting how the account was made.
//
// Spark plan means no Cloud Functions, so there is no server-side hook to put
// this logic in. Rules are it.

service cloud.firestore {
  match /databases/{database}/documents {

    // The site owner. Identified by address rather than by a flag on a
    // document, so it cannot be revoked by anything that goes wrong in the
    // users collection and does not depend on a manual console step.
    //
    // email_verified is what makes this safe. Enabling email-link sign-in also
    // enabled the Email/Password provider, so an account with this address
    // could in principle be created outside our UI — but not verified without
    // access to the inbox, and an unverified token fails here.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'jasmehr2005@gmail.com';
    }

    // Anyone signed in with a verified address, Thapar or not. Google Sign-In
    // means outsiders can hold an account: they can pick a username, browse,
    // and leave reviews. They cannot post in chat or list a venture — those
    // stay behind isThaparUser below.
    //
    // email_verified matters even with Google, because the Email/Password
    // provider is also enabled and an unverified account can exist.
    function isVerifiedUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    // The privileged boundary: posting in All Chat and listing a venture.
    // Full-string match, so an address like someone@thapar.edu.example.com does
    // not slip through. The owner is exempt — the address above is not a Thapar
    // one and would otherwise be unable to moderate at all.
    function isThaparUser() {
      return isOwner()
        || (request.auth != null
            && request.auth.token.email != null
            && request.auth.token.email_verified == true
            && request.auth.token.email.lower().matches('.*@thapar[.]edu'));
    }

    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      // Usernames are shown next to chat messages and ventures, so any signed-in
      // user needs to resolve them. This does expose email addresses to signed-in
      // students; tighten it when chat lands if that turns out to matter.
      allow read: if request.auth != null;

      allow create: if isVerifiedUser()
                    && isSelf(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.email == request.auth.token.email
                    // Nobody gets to make themselves a moderator. Flip this by
                    // hand in the console.
                    && request.resource.data.isModerator == false
                    && request.resource.data.username is string
                    && request.resource.data.username.size() >= 3
                    && request.resource.data.username.size() <= 20;

      allow update: if (isVerifiedUser()
                        && isSelf(uid)
                        && request.resource.data.isModerator == resource.data.isModerator
                        && request.resource.data.email == resource.data.email
                        && request.resource.data.uid == resource.data.uid)
                    // The owner promoting or revoking someone else, and nothing
                    // else about their document — a moderator-picker UI writes
                    // through this, not through the self-update branch above,
                    // which forbids touching isModerator at all.
                    || (isOwner()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isModerator'])
                        && request.resource.data.isModerator is bool);

      // Deleting a user would orphan their username claim and their ventures.
      allow delete: if false;
    }

    // Username uniqueness. The document id IS the claim: ids are unique by
    // definition, and create-only-if-absent is what Firestore's create rule
    // already means, so two people picking the same name at the same moment
    // cannot both succeed.
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if isVerifiedUser() && request.resource.data.uid == request.auth.uid;
      // Immutable — releasing a name would let someone impersonate a past owner.
      allow update, delete: if false;
    }

    // The owner is always a moderator, checked first so it costs no document
    // read and works before any user document exists. Other moderators are
    // still promoted by hand in the console.
    function isModerator() {
      return isOwner()
        || (request.auth != null
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isModerator == true);
    }

    match /ventures/{ventureId} {
      // Three ways to read, and each corresponds to a query the app actually
      // makes. Firestore checks a list query against these, so browse must
      // filter status == 'live', the moderator queue must filter by status,
      // and an owner's own list must filter by ownerId. A query that filters
      // by none of them is refused, which is the intent: nobody can page
      // through everyone's pending submissions.
      allow read: if resource.data.status == 'live'
                  || isModerator()
                  || (request.auth != null && resource.data.ownerId == request.auth.uid);

      allow create: if isThaparUser()
                    && request.resource.data.ownerId == request.auth.uid
                    // The entire point of the approval queue. An owner who
                    // could set this would publish straight past you.
                    && request.resource.data.status == 'pending'
                    && request.resource.data.clickCount == 0
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.phone is string
                    && request.resource.data.description.size() <= 600;

      // Owners may edit content but never status, ownership or the counters.
      // Moderators may change anything, which is how approve and reject work.
      // The first clause is the public view counter, same shape as the one on
      // menu items: exactly one field, exactly plus one.
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount'])
                        && request.resource.data.clickCount == resource.data.clickCount + 1)
                    || isModerator()
                    || (isThaparUser()
                        && resource.data.ownerId == request.auth.uid
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.status == resource.data.status
                        && request.resource.data.clickCount == resource.data.clickCount);

      allow delete: if isModerator()
                    || (request.auth != null && resource.data.ownerId == request.auth.uid);
    }

    match /menuItems/{itemId} {
      // Menu items carry no private data and are always read alongside their
      // venture, so gating them on a get() of the parent would cost an extra
      // billed read per item to protect a price list.
      allow read: if true;

      allow create: if isThaparUser()
                    && request.resource.data.inquiryCount == 0
                    && request.resource.data.price is number
                    && request.resource.data.price >= 0
                    && get(/databases/$(database)/documents/ventures/$(request.resource.data.ventureId)).data.ownerId == request.auth.uid;

      allow update: if
                    // Anyone at all, signed in or not, may add exactly one to
                    // the inquiry counter and change nothing else. Logged-out
                    // people can browse and tap WhatsApp, and they are most of
                    // the traffic — counting only signed-in taps would throw
                    // away the majority of the evidence. The trade is that the
                    // number is inflatable by anyone willing to script it, so
                    // treat it as a signal of interest, not an audited figure.
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inquiryCount'])
                     && request.resource.data.inquiryCount == resource.data.inquiryCount + 1)
                    || isModerator()
                    || (isThaparUser()
                        && get(/databases/$(database)/documents/ventures/$(resource.data.ventureId)).data.ownerId == request.auth.uid
                        && request.resource.data.inquiryCount == resource.data.inquiryCount);

      allow delete: if isModerator()
                    || (request.auth != null
                        && get(/databases/$(database)/documents/ventures/$(resource.data.ventureId)).data.ownerId == request.auth.uid);
    }

    match /chatMessages/{messageId} {
      // Everyone reads, signed in or not. Someone opening a shared link should
      // be able to see the room is alive before being asked for an account.
      allow read: if true;

      allow create: if isThaparUser()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.username is string
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 1000
                    && request.resource.data.deleted == false
                    // Forces serverTimestamp(). A client-supplied time could be
                    // backdated to bury a message at the top of the room.
                    && request.resource.data.createdAt == request.time;

      // Moderator removal, and the only permitted update. The flag and the
      // blanked text have to move together: a soft delete that leaves the text
      // in the document means the message is still readable by anyone querying
      // Firestore directly, which defeats the whole point of the button. Author
      // and timestamp survive, so a repeat offender is still visible.
      allow update: if isModerator()
                    && request.resource.data.deleted == true
                    && request.resource.data.text == ''
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.username == resource.data.username
                    && request.resource.data.createdAt == resource.data.createdAt;

      // No hard delete. Who posted and when is the moderation trail, and it is
      // worth more than the row it occupies.
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;

      // The document id is ventureId_uid, which is what makes one review per
      // person per venture a structural fact rather than something the app
      // remembers to check. A second review lands on the same id and is an
      // edit, not a duplicate.
      allow create: if isVerifiedUser()
                    && reviewId == request.resource.data.ventureId + '_' + request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() <= 500
                    && request.resource.data.deleted == false
                    && request.resource.data.createdAt == request.time
                    // Nobody reviews their own venture.
                    && get(/databases/$(database)/documents/ventures/$(request.resource.data.ventureId)).data.ownerId != request.auth.uid;

      allow update: if
                    // Moderator removal. Same reasoning as chat: a flag that
                    // leaves the comment in the document is a button that lies.
                    // The rating goes with it — the app drops deleted reviews
                    // from the average, because erasing the words of a malicious
                    // one-star while leaving the score would remove the
                    // sentence and keep the damage.
                    (isModerator()
                     && request.resource.data.deleted == true
                     && request.resource.data.comment == ''
                     && request.resource.data.userId == resource.data.userId
                     && request.resource.data.ventureId == resource.data.ventureId
                     && request.resource.data.createdAt == resource.data.createdAt)
                    // The author revising, while it still stands. Changing your
                    // mind about a venture is legitimate; resurrecting a removed
                    // review is not, hence the check on the existing flag.
                    || (isVerifiedUser()
                        && resource.data.userId == request.auth.uid
                        && resource.data.deleted == false
                        && request.resource.data.deleted == false
                        && request.resource.data.userId == resource.data.userId
                        && request.resource.data.ventureId == resource.data.ventureId
                        && request.resource.data.createdAt == resource.data.createdAt
                        && request.resource.data.rating is int
                        && request.resource.data.rating >= 1
                        && request.resource.data.rating <= 5
                        && request.resource.data.comment is string
                        && request.resource.data.comment.size() <= 500);

      // No hard delete, same as chat: who reviewed what is the trail.
      allow delete: if false;
    }

    match /settings/{settingId} {
      // One global backdrop image, shown to every visitor including
      // signed-out ones, so the read has to be open. Only a moderator can
      // change it; an empty write resets to the default baked into the app.
      allow read: if true;

      allow write: if isModerator()
                   && (!('backdrop' in request.resource.data)
                       || (request.resource.data.backdrop.url is string
                           && request.resource.data.backdrop.publicId is string));
    }

    // Everything else stays closed. Any new collection needs its own rules
    // written alongside the feature, not retrofitted afterwards.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
